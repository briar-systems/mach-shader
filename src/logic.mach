# ret:       a where condition is true, else b, in each lane
#[intrinsic("spirv", "core", "OpSelect")]
pub fun select_f16_2(condition: u32x2, a: f16x2, b: f16x2) f16x2;

# Choose between two values by a truth value, per lane.
#
# Both values are evaluated and nothing branches. Each lane is chosen by its own lane of
# the condition.
# Needs the target's `Float16` where it names an `env`.
# ---
# condition: The truth values, one per lane, each true where nonzero.
# a:         The values where the condition is true, one per lane.
# b:         The values where it is false, one per lane.
# ret:       a where condition is true, else b, in each lane
#[intrinsic("spirv", "core", "OpSelect")]
pub fun select_f16_3(condition: u32x3, a: f16x3, b: f16x3) f16x3;

