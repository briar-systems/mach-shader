# semantics: The `SEMANTICS_*` ordering memory around it.
# value:     The value to compare with.
# ret:       the value before the operation
#[op("spirv", "core", "OpAtomicSMax")]
pub fun atomic_max_i64(p: *i64, scope: u32, semantics: u32, value: i64) i64;

