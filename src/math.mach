#[intrinsic("spirv", "core", "OpFwidth")]
pub fun fwidth_3(p: f32x3) f32x3;

# Rate of change along x, from the fragment's own neighbour, per lane.
# ---
# p:   The values, one per lane.
# ret: the difference in x within the fragment's row of its quad per lane
#[intrinsic("spirv", "core", "OpDPdxFine")]
pub fun dpdx_fine_3(p: f32x3) f32x3;

# Rate of change along y, from the fragment's own neighbour, per lane.
# ---
# p:   The values, one per lane.
# ret: the difference in y within the fragment's column of its quad per lane
#[intrinsic("spirv", "core", "OpDPdyFine")]
pub fun dpdy_fine_3(p: f32x3) f32x3;

# Total rate of change from the fragment's own neighbours, per lane.
# ---
# p:   The values, one per lane.
# ret: abs(dpdx_fine(p)) + abs(dpdy_fine(p)) per lane
#[intrinsic("spirv", "core", "OpFwidthFine")]
pub fun fwidth_fine_3(p: f32x3) f32x3;

# Rate of change along x, one value for the whole quad, per lane.
# ---
# p:   The values, one per lane.
# ret: the difference in x the quad shares per lane
#[intrinsic("spirv", "core", "OpDPdxCoarse")]
pub fun dpdx_coarse_3(p: f32x3) f32x3;

# Rate of change along y, one value for the whole quad, per lane.
# ---
# p:   The values, one per lane.
# ret: the difference in y the quad shares per lane
#[intrinsic("spirv", "core", "OpDPdyCoarse")]
pub fun dpdy_coarse_3(p: f32x3) f32x3;

# Total rate of change, one value for the whole quad, per lane.
# ---
# p:   The values, one per lane.
# ret: abs(dpdx_coarse(p)) + abs(dpdy_coarse(p)) per lane
#[intrinsic("spirv", "core", "OpFwidthCoarse")]
pub fun fwidth_coarse_3(p: f32x3) f32x3;

# ----- f32x4 -----

# Rate of change along the window's x axis, per lane.
# ---
# p:   The values, one per lane.
# ret: the difference between neighbouring fragments' values in x per lane
#[intrinsic("spirv", "core", "OpDPdx")]
pub fun dpdx_4(p: f32x4) f32x4;

# Rate of change along the window's y axis, per lane.
# ---
# p:   The values, one per lane.
# ret: the difference between neighbouring fragments' values in y per lane
#[intrinsic("spirv", "core", "OpDPdy")]
pub fun dpdy_4(p: f32x4) f32x4;

# Total rate of change in x and y, per lane.
# ---
# p:   The values, one per lane.
# ret: abs(dpdx(p)) + abs(dpdy(p)) per lane
#[intrinsic("spirv", "core", "OpFwidth")]
pub fun fwidth_4(p: f32x4) f32x4;

# Rate of change along x, from the fragment's own neighbour, per lane.
# ---
# p:   The values, one per lane.
# ret: the difference in x within the fragment's row of its quad per lane
#[intrinsic("spirv", "core", "OpDPdxFine")]
pub fun dpdx_fine_4(p: f32x4) f32x4;

# Rate of change along y, from the fragment's own neighbour, per lane.
# ---
# p:   The values, one per lane.
# ret: the difference in y within the fragment's column of its quad per lane
#[intrinsic("spirv", "core", "OpDPdyFine")]
pub fun dpdy_fine_4(p: f32x4) f32x4;

# Total rate of change from the fragment's own neighbours, per lane.
# ---
# p:   The values, one per lane.
# ret: abs(dpdx_fine(p)) + abs(dpdy_fine(p)) per lane
#[intrinsic("spirv", "core", "OpFwidthFine")]
pub fun fwidth_fine_4(p: f32x4) f32x4;

# Rate of change along x, one value for the whole quad, per lane.
# ---
# p:   The values, one per lane.
# ret: the difference in x the quad shares per lane
#[intrinsic("spirv", "core", "OpDPdxCoarse")]
pub fun dpdx_coarse_4(p: f32x4) f32x4;

# Rate of change along y, one value for the whole quad, per lane.
# ---
# p:   The values, one per lane.
# ret: the difference in y the quad shares per lane
#[intrinsic("spirv", "core", "OpDPdyCoarse")]
pub fun dpdy_coarse_4(p: f32x4) f32x4;

# Total rate of change, one value for the whole quad, per lane.
# ---
# p:   The values, one per lane.
# ret: abs(dpdx_coarse(p)) + abs(dpdy_coarse(p)) per lane
#[intrinsic("spirv", "core", "OpFwidthCoarse")]
pub fun fwidth_coarse_4(p: f32x4) f32x4;

# ---------- geometry ----------
#
# These consume vectors and have no scalar form, but they carry their width like
# every other vector entry: a lighting shader wants the 3-wide `dot3`, and a name
# that means the 4-wide form today would have to be broken to give it one.
#
# `dot` is the odd instruction of the group. GLSL spells it beside `length` and
# `normalize`, but it is not a GLSL.std.450 entry at all; it is core `OpDot`, and
# its decorator says so.

# ----- f32x2 -----

# Dot product.
# ---
# a:   The first vector.
# b:   The second vector.
# ret: the sum of the per-lane products
#[intrinsic("spirv", "core", "OpDot")]
pub fun dot_2(a: f32x2, b: f32x2) f32;

# Euclidean length.
# ---
# v:   The vector.
# ret: sqrt(dot(v, v))
#[intrinsic("spirv", "GLSL.std.450", "Length")]
pub fun length_2(v: f32x2) f32;

# A vector of length 1 in the same direction.
# ---
# v:   The vector.
# ret: v / length(v)
#[intrinsic("spirv", "GLSL.std.450", "Normalize")]
pub fun normalize_2(v: f32x2) f32x2;

# Distance between two points.
# ---
# a:   The first vector.
# b:   The second vector.
# ret: length(a - b)
#[intrinsic("spirv", "GLSL.std.450", "Distance")]
pub fun distance_2(a: f32x2, b: f32x2) f32;

# Reflect an incident vector about a normal.
# ---
# i:   The incident vector.
# n:   The surface normal, which must already be normalized.
# ret: i - 2 * dot(n, i) * n
#[intrinsic("spirv", "GLSL.std.450", "Reflect")]
pub fun reflect_2(i: f32x2, n: f32x2) f32x2;

# Flip a vector to face away from a surface.
# ---
# n:   The surface normal, which must already be normalized.
# i:   The incident vector.
# r:   The reference normal.
# ret: n where dot(r, i) is below zero, else -n
#[intrinsic("spirv", "GLSL.std.450", "FaceForward")]
pub fun face_forward_2(n: f32x2, i: f32x2, r: f32x2) f32x2;

# Refract an incident vector through a surface.
# ---
# i:   The incident vector, which must already be normalized.
# n:   The surface normal, which must already be normalized.
# eta: The ratio of indices of refraction. A scalar at every width.
# ret: the refracted vector, or the zero vector under total internal reflection
#[intrinsic("spirv", "GLSL.std.450", "Refract")]
pub fun refract_2(i: f32x2, n: f32x2, eta: f32) f32x2;

# Scale a vector by a scalar.
#
# The core `OpVectorTimesScalar`. The `*` operator multiplies a vector by a vector
# of one shape, so it scales only once the scalar is built into a vector.
# ---
# v:   The vector.
# s:   The factor every lane is multiplied by. A scalar at every width.
# ret: v with each lane multiplied by s
#[intrinsic("spirv", "core", "OpVectorTimesScalar")]
pub fun scale_2(v: f32x2, s: f32) f32x2;

# ----- f32x3 -----

# Dot product.
# ---
# a:   The first vector.
# b:   The second vector.
# ret: the sum of the per-lane products
#[intrinsic("spirv", "core", "OpDot")]
pub fun dot_3(a: f32x3, b: f32x3) f32;

# Euclidean length.
# ---
# v:   The vector.
# ret: sqrt(dot(v, v))
#[intrinsic("spirv", "GLSL.std.450", "Length")]
pub fun length_3(v: f32x3) f32;

# A vector of length 1 in the same direction.
# ---
# v:   The vector.
# ret: v / length(v)
#[intrinsic("spirv", "GLSL.std.450", "Normalize")]
pub fun normalize_3(v: f32x3) f32x3;

# Distance between two points.
# ---
# a:   The first vector.
# b:   The second vector.
# ret: length(a - b)
#[intrinsic("spirv", "GLSL.std.450", "Distance")]
pub fun distance_3(a: f32x3, b: f32x3) f32;

# Reflect an incident vector about a normal.
# ---
# i:   The incident vector.
# n:   The surface normal, which must already be normalized.
# ret: i - 2 * dot(n, i) * n
#[intrinsic("spirv", "GLSL.std.450", "Reflect")]
pub fun reflect_3(i: f32x3, n: f32x3) f32x3;

# Flip a vector to face away from a surface.
# ---
# n:   The surface normal, which must already be normalized.
# i:   The incident vector.
# r:   The reference normal.
# ret: n where dot(r, i) is below zero, else -n
#[intrinsic("spirv", "GLSL.std.450", "FaceForward")]
pub fun face_forward_3(n: f32x3, i: f32x3, r: f32x3) f32x3;

# Refract an incident vector through a surface.
# ---
# i:   The incident vector, which must already be normalized.
# n:   The surface normal, which must already be normalized.
# eta: The ratio of indices of refraction. A scalar at every width.
# ret: the refracted vector, or the zero vector under total internal reflection
#[intrinsic("spirv", "GLSL.std.450", "Refract")]
pub fun refract_3(i: f32x3, n: f32x3, eta: f32) f32x3;

# Scale a vector by a scalar.
#
# The core `OpVectorTimesScalar`. The `*` operator multiplies a vector by a vector
# of one shape, so it scales only once the scalar is built into a vector.
# ---
# v:   The vector.
# s:   The factor every lane is multiplied by. A scalar at every width.
# ret: v with each lane multiplied by s
#[intrinsic("spirv", "core", "OpVectorTimesScalar")]
pub fun scale_3(v: f32x3, s: f32) f32x3;

# Cross product.
#
# Defined at three lanes and no other, which is why it appears only here.
# It still carries the width, so the rule holds without an exception.
# ---
# a:   The first vector.
# b:   The second vector.
# ret: the vector perpendicular to both, right-handed
#[intrinsic("spirv", "GLSL.std.450", "Cross")]
pub fun cross_3(a: f32x3, b: f32x3) f32x3;

# ----- f32x4 -----

# Dot product.
# ---
# a:   The first vector.
# b:   The second vector.
# ret: the sum of the per-lane products
#[intrinsic("spirv", "core", "OpDot")]
pub fun dot_4(a: f32x4, b: f32x4) f32;

# Euclidean length.
# ---
# v:   The vector.
# ret: sqrt(dot(v, v))
#[intrinsic("spirv", "GLSL.std.450", "Length")]
pub fun length_4(v: f32x4) f32;

# A vector of length 1 in the same direction.
# ---
# v:   The vector.
# ret: v / length(v)
#[intrinsic("spirv", "GLSL.std.450", "Normalize")]
pub fun normalize_4(v: f32x4) f32x4;

# Distance between two points.
# ---
