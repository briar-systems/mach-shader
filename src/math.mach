# A step from 0 to 1 at an edge.
# ---
# edge: Where the step happens.
# x:    The value.
# ret:  0.0 below edge, else 1.0
#[intrinsic("spirv", "GLSL.std.450", "Step")]
pub fun step(edge: f32, x: f32) f32;

# Remainder of a division, as the driver computes it.
#
# Not the `%` operator: a float `%` is computed exactly by code the compiler
# provides, and this is the core `OpFRem`, to whatever precision the driver gives.
# ---
# a:   The dividend.
# b:   The divisor.
# ret: a - b * trunc(a / b), with the sign of a
#[intrinsic("spirv", "core", "OpFRem")]
pub fun rem(a: f32, b: f32) f32;

# Constrain a value to a range.
# ---
# x:   The value.
# lo:  The lower bound.
# hi:  The upper bound.
# ret: min(max(x, lo), hi)
#[intrinsic("spirv", "GLSL.std.450", "FClamp")]
pub fun clamp(x: f32, lo: f32, hi: f32) f32;

# Linear interpolation.
# ---
# a:   The value at t == 0.
# b:   The value at t == 1.
# t:   The interpolant.
# ret: a * (1 - t) + b * t
#[intrinsic("spirv", "GLSL.std.450", "FMix")]
pub fun mix(a: f32, b: f32, t: f32) f32;

# A smooth Hermite step between two edges.
# ---
# lo:  The lower edge.
# hi:  The upper edge.
# x:   The value.
# ret: 0.0 at or below lo, 1.0 at or above hi, a smooth ramp between
#[intrinsic("spirv", "GLSL.std.450", "SmoothStep")]
pub fun smooth_step(lo: f32, hi: f32, x: f32) f32;

# Fused multiply-add.
# ---
# a:   The first factor.
# b:   The second factor.
# c:   The addend.
# ret: a * b + c
#[intrinsic("spirv", "GLSL.std.450", "Fma")]
pub fun fma(a: f32, b: f32, c: f32) f32;

# Split a value into its whole and fractional parts.
# ---
# x:     The value.
# whole: Where the whole part is stored, with the sign of x.
# ret:   the fractional part, with the sign of x
#[intrinsic("spirv", "GLSL.std.450", "Modf")]
pub fun modf(x: f32, whole: *f32) f32;

# Split a value into a significand and a power of two.
# ---
# x:   The value.
# exp: Where the exponent is stored.
# ret: the significand, in [0.5, 1) in magnitude, or zero at zero
#[intrinsic("spirv", "GLSL.std.450", "Frexp")]
pub fun frexp(x: f32, exp: *i32) f32;

# Build a value from a significand and a power of two.
# ---
# x:   The significand.
# exp: The exponent.
# ret: x * 2 ** exp
#[intrinsic("spirv", "GLSL.std.450", "Ldexp")]
pub fun ldexp(x: f32, exp: i32) f32;

