# Reverse the order of the bits.
#
# The core `OpBitReverse`, which no operator writes.
# ---
# x:   The value.
# ret: x with bit n moved to bit 31 - n
#[intrinsic("spirv", "core", "OpBitReverse")]
pub fun reverse_bits_i32(x: i32) i32;

# Replace a field of bits.
#
# The core `OpBitFieldInsert`, which no operator writes. The offset and the
# count must leave the field inside the 32 bits, or the result is undefined.
# ---
# x:      The value.
# insert: Bits to place in the field, taken from bit 0 up.
# offset: Index of the field's lowest bit. A scalar at every width.
# count:  Number of bits in the field. A scalar at every width.
# ret:    x with its count bits from offset replaced by the low bits of insert
#[intrinsic("spirv", "core", "OpBitFieldInsert")]
pub fun insert_bits_i32(x: i32, insert: i32, offset: u32, count: u32) i32;

# Read a field of bits.
