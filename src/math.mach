#[intrinsic("spirv", "core", "OpIAddCarry")]
pub fun add_carry_u16_4(a: u16x4, b: u16x4) AddCarry[u16x4];

# Subtract two values, keeping the borrow, per lane.
#
# The core `OpISubBorrow`: `-` wraps and gives no borrow.
# ---
