pub fun step_3(edge: f32x3, x: f32x3) f32x3;

# Constrain a value to a range, per lane.
# ---
# x:   The values, one per lane.
# lo:  The lower bounds, one per lane.
# hi:  The upper bounds, one per lane.
# ret: min(max(x, lo), hi) per lane
#[spirv_op("GLSL.std.450", "FClamp")]
pub fun clamp_3(x: f32x3, lo: f32x3, hi: f32x3) f32x3;

# Linear interpolation, per lane.
# ---
# a:   The value at t == 0s, one per lane.
# b:   The value at t == 1s, one per lane.
# t:   The interpolants, one per lane.
# ret: a * (1 - t) + b * t per lane
#[spirv_op("GLSL.std.450", "FMix")]
pub fun mix_3(a: f32x3, b: f32x3, t: f32x3) f32x3;

# A smooth Hermite step between two edges, per lane.
# ---
# lo:  The lower edges, one per lane.
# hi:  The upper edges, one per lane.
# x:   The values, one per lane.
# ret: 0.0 at or below lo, 1.0 at or above hi, a smooth ramp between per lane
#[spirv_op("GLSL.std.450", "SmoothStep")]
pub fun smooth_step_3(lo: f32x3, hi: f32x3, x: f32x3) f32x3;

# Fused multiply-add, per lane.
# ---
# a:   The first factors, one per lane.
# b:   The second factors, one per lane.
# c:   The addends, one per lane.
# ret: a * b + c per lane
#[spirv_op("GLSL.std.450", "Fma")]
pub fun fma_3(a: f32x3, b: f32x3, c: f32x3) f32x3;


# ---------- per lane of an f32x4 ----------

# Absolute value, per lane.
# ---
# x:   The values, one per lane.
# ret: |x| per lane
#[spirv_op("GLSL.std.450", "FAbs")]
pub fun abs_4(x: f32x4) f32x4;

# Sign as -1, 0 or +1, per lane.
# ---
# x:   The values, one per lane.
# ret: -1.0 below zero, 0.0 at zero, 1.0 above per lane
#[spirv_op("GLSL.std.450", "FSign")]
pub fun sign_4(x: f32x4) f32x4;

# Largest integer not greater than x, per lane.
# ---
# x:   The values, one per lane.
# ret: floor(x) per lane
#[spirv_op("GLSL.std.450", "Floor")]
pub fun floor_4(x: f32x4) f32x4;

# Smallest integer not less than x, per lane.
# ---
# x:   The values, one per lane.
# ret: ceil(x) per lane
#[spirv_op("GLSL.std.450", "Ceil")]
pub fun ceil_4(x: f32x4) f32x4;

# Fractional part, per lane.
# ---
# x:   The values, one per lane.
# ret: x - floor(x), always in [0, 1) per lane
#[spirv_op("GLSL.std.450", "Fract")]
pub fun fract_4(x: f32x4) f32x4;

# Degrees to radians, per lane.
# ---
# x:   An angle in degrees.
# ret: the same angle in radians per lane
#[spirv_op("GLSL.std.450", "Radians")]
pub fun radians_4(x: f32x4) f32x4;

# Radians to degrees, per lane.
# ---
# x:   An angle in radians.
# ret: the same angle in degrees per lane
#[spirv_op("GLSL.std.450", "Degrees")]
pub fun degrees_4(x: f32x4) f32x4;

# Sine of an angle in radians, per lane.
# ---
# x:   The angle in radians.
# ret: sin(x) per lane
#[spirv_op("GLSL.std.450", "Sin")]
pub fun sin_4(x: f32x4) f32x4;

# Cosine of an angle in radians, per lane.
# ---
# x:   The angle in radians.
# ret: cos(x) per lane
#[spirv_op("GLSL.std.450", "Cos")]
pub fun cos_4(x: f32x4) f32x4;

# Tangent of an angle in radians, per lane.
# ---
# x:   The angle in radians.
# ret: tan(x) per lane
#[spirv_op("GLSL.std.450", "Tan")]
pub fun tan_4(x: f32x4) f32x4;

# Arcsine, per lane.
# ---
# x:   A value in [-1, 1].
# ret: asin(x) in [-pi/2, pi/2] per lane
#[spirv_op("GLSL.std.450", "Asin")]
pub fun asin_4(x: f32x4) f32x4;

# Arccosine, per lane.
# ---
# x:   A value in [-1, 1].
# ret: acos(x) in [0, pi] per lane
#[spirv_op("GLSL.std.450", "Acos")]
pub fun acos_4(x: f32x4) f32x4;

# Arctangent of a single ratio, per lane.
# ---
# x:   The ratios, one per lane.
# ret: atan(x) in [-pi/2, pi/2] per lane
#[spirv_op("GLSL.std.450", "Atan")]
pub fun atan_4(x: f32x4) f32x4;

# e raised to x, per lane.
# ---
# x:   The values, one per lane.
# ret: e ** x per lane
#[spirv_op("GLSL.std.450", "Exp")]
pub fun exp_4(x: f32x4) f32x4;

# Natural logarithm, per lane.
# ---
# x:   A positive value.
# ret: ln(x) per lane
#[spirv_op("GLSL.std.450", "Log")]
pub fun log_4(x: f32x4) f32x4;

# 2 raised to x, per lane.
# ---
# x:   The values, one per lane.
# ret: 2 ** x per lane
#[spirv_op("GLSL.std.450", "Exp2")]
pub fun exp2_4(x: f32x4) f32x4;

# Base-2 logarithm, per lane.
# ---
# x:   A positive value.
# ret: log2(x) per lane
#[spirv_op("GLSL.std.450", "Log2")]
pub fun log2_4(x: f32x4) f32x4;

# Square root, per lane.
# ---
# x:   A non-negative value.
# ret: sqrt(x) per lane
#[spirv_op("GLSL.std.450", "Sqrt")]
pub fun sqrt_4(x: f32x4) f32x4;

# Reciprocal square root, which is what a normalization actually wants, per lane.
# ---
# x:   A positive value.
# ret: 1 / sqrt(x) per lane
#[spirv_op("GLSL.std.450", "InverseSqrt")]
pub fun inverse_sqrt_4(x: f32x4) f32x4;

# Arctangent of y/x, quadrant-correct, per lane.
# ---
# y:   The numerators, one per lane.
# x:   The denominators, one per lane.
# ret: atan2(y, x) in [-pi, pi] per lane
#[spirv_op("GLSL.std.450", "Atan2")]
pub fun atan2_4(y: f32x4, x: f32x4) f32x4;

# x raised to e, per lane.
# ---
# x:   The base, which must not be negatives, one per lane.
# e:   The exponents, one per lane.
# ret: x ** e per lane
#[spirv_op("GLSL.std.450", "Pow")]
pub fun pow_4(x: f32x4, e: f32x4) f32x4;

# Smaller of two values, per lane.
# ---
# a:   The first values, one per lane.
# b:   The second values, one per lane.
# ret: a where a < b, else b per lane
#[spirv_op("GLSL.std.450", "FMin")]
pub fun min_4(a: f32x4, b: f32x4) f32x4;

# Larger of two values, per lane.
# ---
# a:   The first values, one per lane.
# b:   The second values, one per lane.
# ret: a where a > b, else b per lane
#[spirv_op("GLSL.std.450", "FMax")]
pub fun max_4(a: f32x4, b: f32x4) f32x4;

# A step from 0 to 1 at an edge, per lane.
# ---
# edge:Where the step happens.
# x:   The values, one per lane.
# ret: 0.0 below edge, else 1.0 per lane
#[spirv_op("GLSL.std.450", "Step")]
pub fun step_4(edge: f32x4, x: f32x4) f32x4;

# Constrain a value to a range, per lane.
# ---
# x:   The values, one per lane.
# lo:  The lower bounds, one per lane.
# hi:  The upper bounds, one per lane.
# ret: min(max(x, lo), hi) per lane
#[spirv_op("GLSL.std.450", "FClamp")]
pub fun clamp_4(x: f32x4, lo: f32x4, hi: f32x4) f32x4;

# Linear interpolation, per lane.
# ---
# a:   The value at t == 0s, one per lane.
# b:   The value at t == 1s, one per lane.
# t:   The interpolants, one per lane.
# ret: a * (1 - t) + b * t per lane
#[spirv_op("GLSL.std.450", "FMix")]
pub fun mix_4(a: f32x4, b: f32x4, t: f32x4) f32x4;

# A smooth Hermite step between two edges, per lane.
# ---
# lo:  The lower edges, one per lane.
# hi:  The upper edges, one per lane.
# x:   The values, one per lane.
# ret: 0.0 at or below lo, 1.0 at or above hi, a smooth ramp between per lane
#[spirv_op("GLSL.std.450", "SmoothStep")]
pub fun smooth_step_4(lo: f32x4, hi: f32x4, x: f32x4) f32x4;

# Fused multiply-add, per lane.
# ---
# a:   The first factors, one per lane.
# b:   The second factors, one per lane.
# c:   The addends, one per lane.
# ret: a * b + c per lane
#[spirv_op("GLSL.std.450", "Fma")]
pub fun fma_4(a: f32x4, b: f32x4, c: f32x4) f32x4;


# ---------- geometry ----------
#
# These consume vectors and have no scalar form, but they carry their width like
# every other vector entry: a lighting shader wants the 3-wide `dot3`, and a name
# that means the 4-wide form today would have to be broken to give it one.
#
# `dot` is the odd instruction of the group. GLSL spells it beside `length` and
# `normalize`, but it is not a GLSL.std.450 entry at all; it is core `OpDot`, and
# its decorator says so.


# ----- f32x2 -----

# Dot product.
# ---
# a:   The first vector.
# b:   The second vector.
# ret: the sum of the per-lane products
#[spirv_op("core", "OpDot")]
pub fun dot_2(a: f32x2, b: f32x2) f32;

# Euclidean length.
# ---
# v:   The vector.
# ret: sqrt(dot(v, v))
#[spirv_op("GLSL.std.450", "Length")]
pub fun length_2(v: f32x2) f32;

# A vector of length 1 in the same direction.
# ---
# v:   The vector.
# ret: v / length(v)
#[spirv_op("GLSL.std.450", "Normalize")]
pub fun normalize_2(v: f32x2) f32x2;

# Distance between two points.
# ---
# a:   The first vector.
# b:   The second vector.
# ret: length(a - b)
#[spirv_op("GLSL.std.450", "Distance")]
pub fun distance_2(a: f32x2, b: f32x2) f32;

# Reflect an incident vector about a normal.
# ---
# i:   The incident vector.
# n:   The surface normal, which must already be normalized.
# ret: i - 2 * dot(n, i) * n
#[spirv_op("GLSL.std.450", "Reflect")]
pub fun reflect_2(i: f32x2, n: f32x2) f32x2;

# Flip a vector to face away from a surface.
# ---
# n:   The surface normal, which must already be normalized.
# i:   The incident vector.
# r:   The reference normal.
# ret: n where dot(r, i) is below zero, else -n
#[spirv_op("GLSL.std.450", "FaceForward")]
pub fun face_forward_2(n: f32x2, i: f32x2, r: f32x2) f32x2;

# Refract an incident vector through a surface.
# ---
# i:   The incident vector, which must already be normalized.
# n:   The surface normal, which must already be normalized.
# eta: The ratio of indices of refraction. A scalar at every width.
# ret: the refracted vector, or the zero vector under total internal reflection
#[spirv_op("GLSL.std.450", "Refract")]
pub fun refract_2(i: f32x2, n: f32x2, eta: f32) f32x2;


# ----- f32x3 -----

# Dot product.
# ---
# a:   The first vector.
# b:   The second vector.
# ret: the sum of the per-lane products
#[spirv_op("core", "OpDot")]
pub fun dot_3(a: f32x3, b: f32x3) f32;

# Euclidean length.
# ---
# v:   The vector.
# ret: sqrt(dot(v, v))
#[spirv_op("GLSL.std.450", "Length")]
pub fun length_3(v: f32x3) f32;

# A vector of length 1 in the same direction.
# ---
# v:   The vector.
# ret: v / length(v)
#[spirv_op("GLSL.std.450", "Normalize")]
pub fun normalize_3(v: f32x3) f32x3;

# Distance between two points.
# ---
# a:   The first vector.
# b:   The second vector.
# ret: length(a - b)
#[spirv_op("GLSL.std.450", "Distance")]
pub fun distance_3(a: f32x3, b: f32x3) f32;

# Reflect an incident vector about a normal.
# ---
# i:   The incident vector.
# n:   The surface normal, which must already be normalized.
# ret: i - 2 * dot(n, i) * n
#[spirv_op("GLSL.std.450", "Reflect")]
pub fun reflect_3(i: f32x3, n: f32x3) f32x3;

# Flip a vector to face away from a surface.
# ---
# n:   The surface normal, which must already be normalized.
# i:   The incident vector.
# r:   The reference normal.
# ret: n where dot(r, i) is below zero, else -n
#[spirv_op("GLSL.std.450", "FaceForward")]
pub fun face_forward_3(n: f32x3, i: f32x3, r: f32x3) f32x3;

# Refract an incident vector through a surface.
# ---
# i:   The incident vector, which must already be normalized.
# n:   The surface normal, which must already be normalized.
# eta: The ratio of indices of refraction. A scalar at every width.
# ret: the refracted vector, or the zero vector under total internal reflection
#[spirv_op("GLSL.std.450", "Refract")]
pub fun refract_3(i: f32x3, n: f32x3, eta: f32) f32x3;

# Cross product.
#
# Defined at three lanes and no other, which is why it appears only here.
# It still carries the width, so the rule holds without an exception.
# ---
# a:   The first vector.
# b:   The second vector.
# ret: the vector perpendicular to both, right-handed
#[spirv_op("GLSL.std.450", "Cross")]
pub fun cross_3(a: f32x3, b: f32x3) f32x3;


# ----- f32x4 -----

# Dot product.
# ---
# a:   The first vector.
# b:   The second vector.
# ret: the sum of the per-lane products
#[spirv_op("core", "OpDot")]
pub fun dot_4(a: f32x4, b: f32x4) f32;

# Euclidean length.
# ---
# v:   The vector.
# ret: sqrt(dot(v, v))
#[spirv_op("GLSL.std.450", "Length")]
pub fun length_4(v: f32x4) f32;

# A vector of length 1 in the same direction.
# ---
# v:   The vector.
# ret: v / length(v)
#[spirv_op("GLSL.std.450", "Normalize")]
pub fun normalize_4(v: f32x4) f32x4;

# Distance between two points.
