pub fun max_u16_4(a: u16x4, b: u16x4) u16x4;

# Constrain a value to a range, per lane.
# ---
# x:   The values, one per lane.
# lo:  The lower bounds, one per lane.
# hi:  The upper bounds, one per lane.
# ret: min(max(x, lo), hi) per lane
#[intrinsic("spirv", "GLSL.std.450", "UClamp")]
pub fun clamp_u16_4(x: u16x4, lo: u16x4, hi: u16x4) u16x4;

# Add two values, keeping the carry, per lane.
