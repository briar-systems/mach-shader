# x:   A value in [-1, 1].
# ret: acos(x) in [0, pi] per lane
#[intrinsic("spirv", "GLSL.std.450", "Acos")]
pub fun acos_3(x: f32x3) f32x3;

# Arctangent of a single ratio, per lane.
# ---
# x:   The ratios, one per lane.
# ret: atan(x) in [-pi/2, pi/2] per lane
#[intrinsic("spirv", "GLSL.std.450", "Atan")]
pub fun atan_3(x: f32x3) f32x3;

# e raised to x, per lane.
# ---
# x:   The values, one per lane.
# ret: e ** x per lane
#[intrinsic("spirv", "GLSL.std.450", "Exp")]
pub fun exp_3(x: f32x3) f32x3;

# Natural logarithm, per lane.
# ---
# x:   A positive value.
# ret: ln(x) per lane
#[intrinsic("spirv", "GLSL.std.450", "Log")]
pub fun log_3(x: f32x3) f32x3;

# 2 raised to x, per lane.
# ---
# x:   The values, one per lane.
# ret: 2 ** x per lane
#[intrinsic("spirv", "GLSL.std.450", "Exp2")]
pub fun exp2_3(x: f32x3) f32x3;

# Base-2 logarithm, per lane.
# ---
# x:   A positive value.
# ret: log2(x) per lane
#[intrinsic("spirv", "GLSL.std.450", "Log2")]
pub fun log2_3(x: f32x3) f32x3;

# Square root, per lane.
# ---
# x:   A non-negative value.
# ret: sqrt(x) per lane
#[intrinsic("spirv", "GLSL.std.450", "Sqrt")]
pub fun sqrt_3(x: f32x3) f32x3;

# Reciprocal square root, which is what a normalization actually wants, per lane.
# ---
# x:   A positive value.
# ret: 1 / sqrt(x) per lane
#[intrinsic("spirv", "GLSL.std.450", "InverseSqrt")]
pub fun inverse_sqrt_3(x: f32x3) f32x3;

# Arctangent of y/x, quadrant-correct, per lane.
# ---
# y:   The numerators, one per lane.
# x:   The denominators, one per lane.
# ret: atan2(y, x) in [-pi, pi] per lane
#[intrinsic("spirv", "GLSL.std.450", "Atan2")]
pub fun atan2_3(y: f32x3, x: f32x3) f32x3;

# x raised to e, per lane.
# ---
# x:   The base, which must not be negatives, one per lane.
# e:   The exponents, one per lane.
# ret: x ** e per lane
#[intrinsic("spirv", "GLSL.std.450", "Pow")]
pub fun pow_3(x: f32x3, e: f32x3) f32x3;

# Smaller of two values, per lane.
# ---
# a:   The first values, one per lane.
# b:   The second values, one per lane.
# ret: a where a < b, else b per lane
#[intrinsic("spirv", "GLSL.std.450", "FMin")]
pub fun min_3(a: f32x3, b: f32x3) f32x3;

# Larger of two values, per lane.
# ---
# a:   The first values, one per lane.
# b:   The second values, one per lane.
# ret: a where a > b, else b per lane
#[intrinsic("spirv", "GLSL.std.450", "FMax")]
pub fun max_3(a: f32x3, b: f32x3) f32x3;

# A step from 0 to 1 at an edge, per lane.
# ---
# edge: Where the step happens.
# x:    The values, one per lane.
# ret:  0.0 below edge, else 1.0 per lane
#[intrinsic("spirv", "GLSL.std.450", "Step")]
pub fun step_3(edge: f32x3, x: f32x3) f32x3;

# Remainder of a division, as the driver computes it, per lane.
#
# Not the `%` operator: a float `%` is computed exactly by code the compiler
# provides, and this is the core `OpFRem`, to whatever precision the driver gives.
# ---
# a:   The dividends, one per lane.
# b:   The divisors, one per lane.
# ret: a - b * trunc(a / b), with the sign of a per lane
#[intrinsic("spirv", "core", "OpFRem")]
pub fun rem_3(a: f32x3, b: f32x3) f32x3;

# Constrain a value to a range, per lane.
# ---
# x:   The values, one per lane.
# lo:  The lower bounds, one per lane.
# hi:  The upper bounds, one per lane.
# ret: min(max(x, lo), hi) per lane
#[intrinsic("spirv", "GLSL.std.450", "FClamp")]
pub fun clamp_3(x: f32x3, lo: f32x3, hi: f32x3) f32x3;

# Linear interpolation, per lane.
# ---
# a:   The value at t == 0s, one per lane.
# b:   The value at t == 1s, one per lane.
# t:   The interpolants, one per lane.
# ret: a * (1 - t) + b * t per lane
#[intrinsic("spirv", "GLSL.std.450", "FMix")]
pub fun mix_3(a: f32x3, b: f32x3, t: f32x3) f32x3;

# A smooth Hermite step between two edges, per lane.
# ---
# lo:  The lower edges, one per lane.
# hi:  The upper edges, one per lane.
# x:   The values, one per lane.
# ret: 0.0 at or below lo, 1.0 at or above hi, a smooth ramp between per lane
#[intrinsic("spirv", "GLSL.std.450", "SmoothStep")]
pub fun smooth_step_3(lo: f32x3, hi: f32x3, x: f32x3) f32x3;

# Fused multiply-add, per lane.
# ---
# a:   The first factors, one per lane.
# b:   The second factors, one per lane.
# c:   The addends, one per lane.
# ret: a * b + c per lane
#[intrinsic("spirv", "GLSL.std.450", "Fma")]
pub fun fma_3(a: f32x3, b: f32x3, c: f32x3) f32x3;

# Split a value into its whole and fractional parts, per lane.
# ---
# x:     The values, one per lane.
# whole: Where the whole part is stored, with the sign of x.
# ret:   the fractional part, with the sign of x per lane
#[intrinsic("spirv", "GLSL.std.450", "Modf")]
pub fun modf_3(x: f32x3, whole: *f32x3) f32x3;

# Split a value into a significand and a power of two, per lane.
# ---
# x:   The values, one per lane.
# exp: Where the exponent is stored.
# ret: the significand, in [0.5, 1) in magnitude, or zero at zero per lane
#[intrinsic("spirv", "GLSL.std.450", "Frexp")]
pub fun frexp_3(x: f32x3, exp: *i32x3) f32x3;

# Build a value from a significand and a power of two, per lane.
# ---
# x:   The significands, one per lane.
# exp: The exponents, one per lane.
# ret: x * 2 ** exp per lane
#[intrinsic("spirv", "GLSL.std.450", "Ldexp")]
pub fun ldexp_3(x: f32x3, exp: i32x3) f32x3;

# ---------- per lane of an f32x4 ----------

# Absolute value, per lane.
# ---
# x:   The values, one per lane.
# ret: |x| per lane
#[intrinsic("spirv", "GLSL.std.450", "FAbs")]
pub fun abs_4(x: f32x4) f32x4;

# Sign as -1, 0 or +1, per lane.
# ---
# x:   The values, one per lane.
# ret: -1.0 below zero, 0.0 at zero, 1.0 above per lane
#[intrinsic("spirv", "GLSL.std.450", "FSign")]
pub fun sign_4(x: f32x4) f32x4;

# Largest integer not greater than x, per lane.
# ---
# x:   The values, one per lane.
# ret: floor(x) per lane
#[intrinsic("spirv", "GLSL.std.450", "Floor")]
pub fun floor_4(x: f32x4) f32x4;

# Smallest integer not less than x, per lane.
# ---
# x:   The values, one per lane.
# ret: ceil(x) per lane
#[intrinsic("spirv", "GLSL.std.450", "Ceil")]
pub fun ceil_4(x: f32x4) f32x4;

# Fractional part, per lane.
# ---
# x:   The values, one per lane.
# ret: x - floor(x), always in [0, 1) per lane
#[intrinsic("spirv", "GLSL.std.450", "Fract")]
pub fun fract_4(x: f32x4) f32x4;

# Degrees to radians, per lane.
# ---
# x:   An angle in degrees.
# ret: the same angle in radians per lane
#[intrinsic("spirv", "GLSL.std.450", "Radians")]
pub fun radians_4(x: f32x4) f32x4;

# Radians to degrees, per lane.
# ---
# x:   An angle in radians.
# ret: the same angle in degrees per lane
#[intrinsic("spirv", "GLSL.std.450", "Degrees")]
pub fun degrees_4(x: f32x4) f32x4;

# Sine of an angle in radians, per lane.
# ---
# x:   The angle in radians.
# ret: sin(x) per lane
#[intrinsic("spirv", "GLSL.std.450", "Sin")]
pub fun sin_4(x: f32x4) f32x4;

# Cosine of an angle in radians, per lane.
# ---
# x:   The angle in radians.
# ret: cos(x) per lane
