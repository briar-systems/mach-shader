#[intrinsic("spirv", "GLSL.std.450", "SmoothStep")]
pub fun smooth_step_4(lo: f32x4, hi: f32x4, x: f32x4) f32x4;

# Fused multiply-add, per lane.
# ---
# a:   The first factors, one per lane.
# b:   The second factors, one per lane.
# c:   The addends, one per lane.
# ret: a * b + c per lane
#[intrinsic("spirv", "GLSL.std.450", "Fma")]
pub fun fma_4(a: f32x4, b: f32x4, c: f32x4) f32x4;

# Split a value into its whole and fractional parts, per lane.
# ---
# x:     The values, one per lane.
# whole: Where the whole part is stored, with the sign of x.
# ret:   the fractional part, with the sign of x per lane
#[intrinsic("spirv", "GLSL.std.450", "Modf")]
pub fun modf_4(x: f32x4, whole: *f32x4) f32x4;

# Split a value into a significand and a power of two, per lane.
# ---
# x:   The values, one per lane.
# exp: Where the exponent is stored.
# ret: the significand, in [0.5, 1) in magnitude, or zero at zero per lane
#[intrinsic("spirv", "GLSL.std.450", "Frexp")]
pub fun frexp_4(x: f32x4, exp: *i32x4) f32x4;

# Build a value from a significand and a power of two, per lane.
# ---
# x:   The significands, one per lane.
# exp: The exponents, one per lane.
# ret: x * 2 ** exp per lane
#[intrinsic("spirv", "GLSL.std.450", "Ldexp")]
pub fun ldexp_4(x: f32x4, exp: i32x4) f32x4;

# ---------- derivatives ----------
#
# A derivative is the difference between a value in neighbouring fragments of a 2x2
# quad, so it exists in a fragment stage only, and a call from any other stage is
# refused where it is written. The plain forms leave the choice of neighbour to the
# driver, the fine forms take the fragment's own, and the coarse forms one for the
# whole quad. Each is a core instruction over 32-bit floats.

# ----- f32 -----

# Rate of change along the window's x axis.
# ---
# p:   The value.
# ret: the difference between neighbouring fragments' values in x
#[intrinsic("spirv", "core", "OpDPdx")]
pub fun dpdx(p: f32) f32;

# Rate of change along the window's y axis.
# ---
# p:   The value.
# ret: the difference between neighbouring fragments' values in y
#[intrinsic("spirv", "core", "OpDPdy")]
pub fun dpdy(p: f32) f32;

# Total rate of change in x and y.
# ---
# p:   The value.
# ret: abs(dpdx(p)) + abs(dpdy(p))
#[intrinsic("spirv", "core", "OpFwidth")]
pub fun fwidth(p: f32) f32;

# Rate of change along x, from the fragment's own neighbour.
# ---
# p:   The value.
# ret: the difference in x within the fragment's row of its quad
#[intrinsic("spirv", "core", "OpDPdxFine")]
pub fun dpdx_fine(p: f32) f32;

# Rate of change along y, from the fragment's own neighbour.
# ---
# p:   The value.
# ret: the difference in y within the fragment's column of its quad
#[intrinsic("spirv", "core", "OpDPdyFine")]
pub fun dpdy_fine(p: f32) f32;

# Total rate of change from the fragment's own neighbours.
# ---
# p:   The value.
# ret: abs(dpdx_fine(p)) + abs(dpdy_fine(p))
#[intrinsic("spirv", "core", "OpFwidthFine")]
pub fun fwidth_fine(p: f32) f32;

# Rate of change along x, one value for the whole quad.
# ---
# p:   The value.
# ret: the difference in x the quad shares
#[intrinsic("spirv", "core", "OpDPdxCoarse")]
pub fun dpdx_coarse(p: f32) f32;

# Rate of change along y, one value for the whole quad.
# ---
# p:   The value.
# ret: the difference in y the quad shares
#[intrinsic("spirv", "core", "OpDPdyCoarse")]
pub fun dpdy_coarse(p: f32) f32;

# Total rate of change, one value for the whole quad.
# ---
# p:   The value.
# ret: abs(dpdx_coarse(p)) + abs(dpdy_coarse(p))
#[intrinsic("spirv", "core", "OpFwidthCoarse")]
pub fun fwidth_coarse(p: f32) f32;

# ----- f32x2 -----

# Rate of change along the window's x axis, per lane.
# ---
# p:   The values, one per lane.
# ret: the difference between neighbouring fragments' values in x per lane
#[intrinsic("spirv", "core", "OpDPdx")]
pub fun dpdx_2(p: f32x2) f32x2;

# Rate of change along the window's y axis, per lane.
# ---
# p:   The values, one per lane.
# ret: the difference between neighbouring fragments' values in y per lane
#[intrinsic("spirv", "core", "OpDPdy")]
pub fun dpdy_2(p: f32x2) f32x2;

# Total rate of change in x and y, per lane.
# ---
# p:   The values, one per lane.
# ret: abs(dpdx(p)) + abs(dpdy(p)) per lane
#[intrinsic("spirv", "core", "OpFwidth")]
pub fun fwidth_2(p: f32x2) f32x2;

# Rate of change along x, from the fragment's own neighbour, per lane.
# ---
# p:   The values, one per lane.
# ret: the difference in x within the fragment's row of its quad per lane
#[intrinsic("spirv", "core", "OpDPdxFine")]
pub fun dpdx_fine_2(p: f32x2) f32x2;

# Rate of change along y, from the fragment's own neighbour, per lane.
# ---
# p:   The values, one per lane.
# ret: the difference in y within the fragment's column of its quad per lane
#[intrinsic("spirv", "core", "OpDPdyFine")]
pub fun dpdy_fine_2(p: f32x2) f32x2;

# Total rate of change from the fragment's own neighbours, per lane.
# ---
# p:   The values, one per lane.
# ret: abs(dpdx_fine(p)) + abs(dpdy_fine(p)) per lane
#[intrinsic("spirv", "core", "OpFwidthFine")]
pub fun fwidth_fine_2(p: f32x2) f32x2;

# Rate of change along x, one value for the whole quad, per lane.
# ---
# p:   The values, one per lane.
# ret: the difference in x the quad shares per lane
#[intrinsic("spirv", "core", "OpDPdxCoarse")]
pub fun dpdx_coarse_2(p: f32x2) f32x2;

# Rate of change along y, one value for the whole quad, per lane.
# ---
# p:   The values, one per lane.
# ret: the difference in y the quad shares per lane
#[intrinsic("spirv", "core", "OpDPdyCoarse")]
pub fun dpdy_coarse_2(p: f32x2) f32x2;

# Total rate of change, one value for the whole quad, per lane.
# ---
# p:   The values, one per lane.
# ret: abs(dpdx_coarse(p)) + abs(dpdy_coarse(p)) per lane
#[intrinsic("spirv", "core", "OpFwidthCoarse")]
pub fun fwidth_coarse_2(p: f32x2) f32x2;

# ----- f32x3 -----

# Rate of change along the window's x axis, per lane.
# ---
# p:   The values, one per lane.
# ret: the difference between neighbouring fragments' values in x per lane
#[intrinsic("spirv", "core", "OpDPdx")]
pub fun dpdx_3(p: f32x3) f32x3;

# Rate of change along the window's y axis, per lane.
# ---
# p:   The values, one per lane.
