#[intrinsic("spirv", "GLSL.std.450", "FindILsb")]
pub fun find_lsb_i32(x: i32) i32;

# Index of the most significant bit that differs from the sign.
# ---
# x:   The value.
# ret: the bit index, or every bit set (-1) where there is none
#[intrinsic("spirv", "GLSL.std.450", "FindSMsb")]
pub fun find_msb_i32(x: i32) i32;

# Number of set bits.
# ---
# x:   The value.
