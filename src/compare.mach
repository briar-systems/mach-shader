# a:   The left operands, one per lane.
# b:   The right operands, one per lane.
# ret: 1 where a is greater than or equal to b or either is NaN, else 0 in each lane
#[intrinsic("spirv", "core", "OpFUnordGreaterThanEqual")]
pub fun unordered_greater_equal_f64_4(a: f64x4, b: f64x4) u32x4;

# Whether a value is NaN, per lane.
#
# Needs the target's `Float64` where it names an `env`.
# ---
# x:   The values, one per lane.
# ret: 1 where x is NaN, else 0 in each lane
#[intrinsic("spirv", "core", "OpIsNan")]
pub fun is_nan_f64_4(x: f64x4) u32x4;

# Whether a value is an infinity, per lane.
#
# Needs the target's `Float64` where it names an `env`.
# ---
# x:   The values, one per lane.
# ret: 1 where x is an infinity, else 0 in each lane
#[intrinsic("spirv", "core", "OpIsInf")]
pub fun is_inf_f64_4(x: f64x4) u32x4;
