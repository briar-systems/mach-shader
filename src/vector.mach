# A vector built from the lanes of two.
#
# Needs the target's `Float64` where it names an `env`.
# ---
# first:  The first vector, whose lanes are numbered from 0.
# second: The second vector, whose lanes are numbered from 4.
# x:      The source lane of the result's lane 0, a constant.
# y:      The source lane of the result's lane 1, a constant.
# ret:    the lane each index names, in order
#[intrinsic("spirv", "core", "OpVectorShuffle")]
pub fun shuffle_f64_4_4_2(first: f64x4, second: f64x4, x: u32, y: u32) f64x2;

# A vector built from the lanes of two.
#
# Needs the target's `Float64` where it names an `env`.
# ---
# first:  The first vector, whose lanes are numbered from 0.
# second: The second vector, whose lanes are numbered from 4.
# x:      The source lane of the result's lane 0, a constant.
# y:      The source lane of the result's lane 1, a constant.
# z:      The source lane of the result's lane 2, a constant.
# ret:    the lane each index names, in order
#[intrinsic("spirv", "core", "OpVectorShuffle")]
pub fun shuffle_f64_4_4_3(first: f64x4, second: f64x4, x: u32, y: u32, z: u32) f64x3;

# A vector built from the lanes of two.
#
# Needs the target's `Float64` where it names an `env`.
# ---
# first:  The first vector, whose lanes are numbered from 0.
# second: The second vector, whose lanes are numbered from 4.
# x:      The source lane of the result's lane 0, a constant.
# y:      The source lane of the result's lane 1, a constant.
# z:      The source lane of the result's lane 2, a constant.
# w:      The source lane of the result's lane 3, a constant.
# ret:    the lane each index names, in order
#[intrinsic("spirv", "core", "OpVectorShuffle")]
pub fun shuffle_f64_4_4_4(first: f64x4, second: f64x4, x: u32, y: u32, z: u32, w: u32) f64x4;
