    acc                 = acc + at.atomic_add_f64(?s_f64[i], sy.SCOPE_WORKGROUP, sy.SEMANTICS_ACQUIRE_RELEASE | WG, 1.0);
    acc                 = acc + at.atomic_min_f64(?s_f64[i], sy.SCOPE_WORKGROUP, sy.SEMANTICS_ACQUIRE_RELEASE | WG, 1.0);
