# Every texture read that is not a plain sample: depth comparisons, gathers, fetches
# and the size and level queries, over every handle shape each one takes.
#
# This exists to be compiled and validated, not to shade anything. It is a fragment
# stage because an implicit-lod comparison derives its level from a fragment stage's
# derivatives, and it carries a compute stage beside it for the explicit-lod samples,
# which a compute stage reaches and an implicit-lod one cannot. Every result is
# written to an output or a buffer so no call can be eliminated.

use tex: shader.texture;

#[sampler(0, 0)]
var shadow_2d:         tex.DepthSampler2D;
#[sampler(0, 1)]
var shadow_2d_array:   tex.DepthSampler2DArray;
#[sampler(0, 2)]
var shadow_cube:       tex.DepthSamplerCube;
#[sampler(0, 3)]
var shadow_cube_array: tex.DepthSamplerCubeArray;
#[sampler(0, 4)]
var albedo:            tex.Sampler2D;
#[sampler(0, 5)]
var layers:            tex.Sampler2DArray;
#[sampler(0, 6)]
var env:               tex.SamplerCube;
#[sampler(0, 7)]
var envs:              tex.SamplerCubeArray;
#[sampler(0, 8)]
var signed:            tex.ISampler2D;
#[sampler(0, 9)]
var ids:               tex.USampler2D;

#[sampler(0, 10)]
var ramp:   tex.Sampler1D;
#[sampler(0, 11)]
var volume: tex.Sampler3D;

# the separately-bound images the fetches and queries read, and the sampler the depth
# images are combined with
#[sampler(1, 0)]
var smp:              tex.Sampler;
#[sampler(1, 1)]
var line_tex:         tex.Texture1D;
#[sampler(1, 2)]
var base_tex:         tex.Texture2D;
#[sampler(1, 3)]
var volume_tex:       tex.Texture3D;
#[sampler(1, 4)]
var env_tex:          tex.TextureCube;
#[sampler(1, 5)]
var layers_tex:       tex.Texture2DArray;
#[sampler(1, 6)]
var envs_tex:         tex.TextureCubeArray;
#[sampler(1, 7)]
var signed_tex:       tex.ITexture2D;
#[sampler(1, 8)]
var ids_tex:          tex.UTexture2D;
#[sampler(1, 9)]
var depth_tex:        tex.DepthTexture2D;
#[sampler(1, 10)]
var depth_layers_tex: tex.DepthTexture2DArray;
#[sampler(1, 11)]
var depth_cube_tex:   tex.DepthTextureCube;
#[sampler(1, 12)]
var depth_cubes_tex:  tex.DepthTextureCubeArray;

#[input(0)]
var in_uv:    f32x2;
#[input(1)]
var in_uvw:   f32x3;
#[input(2)]
var in_uvwl:  f32x4;
#[input(3)]
var in_depth: f32;
#[input(4)]
var in_at:    i32x3;

#[output(0)]
var out_colour: f32x4;
#[output(1)]
var out_ids:    u32x4;
#[output(2)]
var out_signed: i32x4;
#[output(3)]
var out_size:   i32x4;

#[stage("fragment")]
fun frag_compare() {
    val c: f32 = tex.sample_compare_2d(shadow_2d, in_uv, in_depth)
        + tex.sample_compare_2d_array(shadow_2d_array, in_uvw, in_depth)
        + tex.sample_compare_cube(shadow_cube, in_uvw, in_depth)
        + tex.sample_compare_cube_array(shadow_cube_array, in_uvwl, in_depth)
        + tex.sample_compare_lod_2d(shadow_2d, in_uv, in_depth, tex.IMAGE_OPERANDS_LOD, 0.0)
        + tex.sample_compare_lod_2d_array(shadow_2d_array, in_uvw, in_depth, tex.IMAGE_OPERANDS_LOD, 0.0)
        + tex.sample_compare_lod_cube(shadow_cube, in_uvw, in_depth, tex.IMAGE_OPERANDS_LOD, 0.0)
        + tex.sample_compare_lod_cube_array(shadow_cube_array, in_uvwl, in_depth, tex.IMAGE_OPERANDS_LOD, 0.0)
        + tex.sample_compare_2d(tex.combine_depth_2d(depth_tex, smp), in_uv, in_depth)
        + tex.sample_compare_2d_array(tex.combine_depth_2d_array(depth_layers_tex, smp), in_uvw, in_depth)
        + tex.sample_compare_cube(tex.combine_depth_cube(depth_cube_tex, smp), in_uvw, in_depth)
        + tex.sample_compare_cube_array(tex.combine_depth_cube_array(depth_cubes_tex, smp), in_uvwl, in_depth);
    out_colour = f32x4{c, c, c, c} + tex.gather_compare_2d(shadow_2d, in_uv, in_depth)
        + tex.gather_compare_2d_array(shadow_2d_array, in_uvw, in_depth)
        + tex.gather_compare_cube(shadow_cube, in_uvw, in_depth)
        + tex.gather_compare_cube_array(shadow_cube_array, in_uvwl, in_depth);
}

#[stage("fragment")]
fun frag_gather() {
    out_colour = tex.gather_2d(albedo, in_uv, 0)
        + tex.gather_2d_array(layers, in_uvw, 1)
        + tex.gather_cube(env, in_uvw, 2)
        + tex.gather_cube_array(envs, in_uvwl, 3);
    out_signed = tex.gather_2d_i(signed, in_uv, 0);
    out_ids    = tex.gather_2d_u(ids, in_uv, 0);
}

#[stage("fragment")]
fun frag_fetch() {
    val at: i32x2 = i32x2{in_at[0], in_at[1]};
    out_colour = tex.fetch_1d(line_tex, in_at[0], tex.IMAGE_OPERANDS_LOD, 0)
        + tex.fetch_2d(base_tex, at, tex.IMAGE_OPERANDS_LOD, 1)
        + tex.fetch_3d(volume_tex, in_at, tex.IMAGE_OPERANDS_LOD, 0)
        + tex.fetch_2d_array(layers_tex, in_at, tex.IMAGE_OPERANDS_LOD, 0);
    out_signed = tex.fetch_2d_i(signed_tex, at, tex.IMAGE_OPERANDS_LOD, 0);
    out_ids    = tex.fetch_2d_u(ids_tex, at, tex.IMAGE_OPERANDS_LOD, 0);
}

#[stage("fragment")]
fun frag_query() {
    val s2: i32x2 = tex.size_2d(base_tex, 0) + tex.size_cube(env_tex, 0)
        + tex.size_2d_i(signed_tex, 0) + tex.size_2d_u(ids_tex, 0)
        + tex.size_depth_2d(depth_tex, 0) + tex.size_depth_cube(depth_cube_tex, 0);
    val s3: i32x3 = tex.size_3d(volume_tex, 0) + tex.size_2d_array(layers_tex, 0)
        + tex.size_cube_array(envs_tex, 0) + tex.size_depth_2d_array(depth_layers_tex, 0)
        + tex.size_depth_cube_array(depth_cubes_tex, 0);
    val levels: i32 = tex.levels_1d(line_tex) + tex.levels_2d(base_tex) + tex.levels_3d(volume_tex)
        + tex.levels_cube(env_tex) + tex.levels_2d_array(layers_tex) + tex.levels_cube_array(envs_tex)
        + tex.levels_2d_i(signed_tex) + tex.levels_2d_u(ids_tex)
        + tex.levels_depth_2d(depth_tex) + tex.levels_depth_2d_array(depth_layers_tex)
        + tex.levels_depth_cube(depth_cube_tex) + tex.levels_depth_cube_array(depth_cubes_tex);
    out_size = i32x4{s2[0] + s3[0], s2[1] + s3[1], s3[2], levels + tex.size_1d(line_tex, 0)};
}

rec Samples {
    colour: [64]f32x4;
    signed: [64]i32x4;
    ids:    [64]u32x4;
}

#[storage(2, 0, "writeonly")]
var samples: Samples;

#[builtin("local_invocation_index")]
var lid: u32;

#[stage("compute")]
#[workgroup(64, 1, 1)]
fun comp_explicit() {
    val i:  u32   = lid;
    val t:  f32   = i::f32 / 64.0;
    val t2: f32x2 = f32x2{t, t};
    val t3: f32x3 = f32x3{t, t, t};
    val t4: f32x4 = f32x4{t, t, t, t};
    val L:  u32   = tex.IMAGE_OPERANDS_LOD;
    val G:  u32   = tex.IMAGE_OPERANDS_GRAD;
    samples.colour[i] = tex.sample_lod_1d(ramp, t, L, 0.0) + tex.sample_lod_2d(albedo, t2, L, 1.0)
        + tex.sample_lod_3d(volume, t3, L, 0.0) + tex.sample_lod_cube(env, t3, L, 0.0)
        + tex.sample_lod_2d_array(layers, t3, L, 0.0) + tex.sample_lod_cube_array(envs, t4, L, 0.0)
        + tex.sample_grad_1d(ramp, t, G, 0.1, 0.1) + tex.sample_grad_2d(albedo, t2, G, t2, t2)
        + tex.sample_grad_3d(volume, t3, G, t3, t3) + tex.sample_grad_cube(env, t3, G, t3, t3)
        + tex.sample_grad_2d_array(layers, t3, G, t2, t2) + tex.sample_grad_cube_array(envs, t4, G, t3, t3);
    samples.signed[i] = tex.sample_lod_2d_i(signed, t2, L, 0.0) + tex.sample_grad_2d_i(signed, t2, G, t2, t2);
    samples.ids[i]    = tex.sample_lod_2d_u(ids, t2, L, 0.0) + tex.sample_grad_2d_u(ids, t2, G, t2, t2);
}
