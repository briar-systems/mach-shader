# Calls every entry in `shader.logic`.
#
# This exists to be compiled, not to be dispatched. Each call forces the compiler to
# resolve an `#[intrinsic]` decorator and emit the instruction at that type, so a wrong
# instruction name or a signature SPIR-V rejects turns into a build failure here, and
# `tools/instcheck.py` finds each instruction in the built module at its own types. The
# target names no `env`, so it holds every capability a 16- or 64-bit entry needs.
#
# Every value comes from a storage buffer and is cast only between integers or between
# floats, so the module holds no comparison or select the program did not call, and every
# result is added to a total written to a buffer, so no call can be eliminated as dead.
#
# This file is generated from the declarations `tools/gencore.py` writes, so an entry
# added to its table is called here without an edit. Run
# `python3 tools/gencore.py logic --conform > conform/src/conform_logic_comp.mach`.

use m: shader.logic;

rec Inputs {
    u: [2]u32x4;
    i: [2]i32x4;
    f: [2]f32x4;
}

rec Outputs {
    u: u32;
    f: f32;
}

#[gpu.storage(0, 0, "readonly")]
var inputs:  Inputs;
#[gpu.storage(0, 1)]
var outputs: Outputs;

#[gpu.stage("compute")]
#[gpu.workgroup(1, 1, 1)]
fun comp_main() {
    val x_u32:   u32   = inputs.u[0][0];
    val y_u32:   u32   = inputs.u[1][0];
    val x_u32x2: u32x2 = u32x2{inputs.u[0][0], inputs.u[0][1]};
    val y_u32x2: u32x2 = u32x2{inputs.u[1][0], inputs.u[1][1]};
    val x_u32x3: u32x3 = u32x3{inputs.u[0][0], inputs.u[0][1], inputs.u[0][2]};
    val y_u32x3: u32x3 = u32x3{inputs.u[1][0], inputs.u[1][1], inputs.u[1][2]};
    val x_u32x4: u32x4 = u32x4{inputs.u[0][0], inputs.u[0][1], inputs.u[0][2], inputs.u[0][3]};
    val y_u32x4: u32x4 = u32x4{inputs.u[1][0], inputs.u[1][1], inputs.u[1][2], inputs.u[1][3]};
    val y_i16:   i16   = inputs.i[1][0]::i16;
    val x_i16:   i16   = inputs.i[0][0]::i16;
    val y_i16x2: i16x2 = i16x2{inputs.i[1][0]::i16, inputs.i[1][1]::i16};
    val x_i16x2: i16x2 = i16x2{inputs.i[0][0]::i16, inputs.i[0][1]::i16};
    val y_i16x3: i16x3 = i16x3{inputs.i[1][0]::i16, inputs.i[1][1]::i16, inputs.i[1][2]::i16};
    val x_i16x3: i16x3 = i16x3{inputs.i[0][0]::i16, inputs.i[0][1]::i16, inputs.i[0][2]::i16};
    val y_i16x4: i16x4 = i16x4{inputs.i[1][0]::i16, inputs.i[1][1]::i16, inputs.i[1][2]::i16, inputs.i[1][3]::i16};
    val x_i16x4: i16x4 = i16x4{inputs.i[0][0]::i16, inputs.i[0][1]::i16, inputs.i[0][2]::i16, inputs.i[0][3]::i16};
    val y_u16:   u16   = inputs.u[1][0]::u16;
    val x_u16:   u16   = inputs.u[0][0]::u16;
    val y_u16x2: u16x2 = u16x2{inputs.u[1][0]::u16, inputs.u[1][1]::u16};
    val x_u16x2: u16x2 = u16x2{inputs.u[0][0]::u16, inputs.u[0][1]::u16};
    val y_u16x3: u16x3 = u16x3{inputs.u[1][0]::u16, inputs.u[1][1]::u16, inputs.u[1][2]::u16};
    val x_u16x3: u16x3 = u16x3{inputs.u[0][0]::u16, inputs.u[0][1]::u16, inputs.u[0][2]::u16};
    val y_u16x4: u16x4 = u16x4{inputs.u[1][0]::u16, inputs.u[1][1]::u16, inputs.u[1][2]::u16, inputs.u[1][3]::u16};
    val x_u16x4: u16x4 = u16x4{inputs.u[0][0]::u16, inputs.u[0][1]::u16, inputs.u[0][2]::u16, inputs.u[0][3]::u16};
    val y_i32:   i32   = inputs.i[1][0];
    val x_i32:   i32   = inputs.i[0][0];
    val y_i32x2: i32x2 = i32x2{inputs.i[1][0], inputs.i[1][1]};
    val x_i32x2: i32x2 = i32x2{inputs.i[0][0], inputs.i[0][1]};
    val y_i32x3: i32x3 = i32x3{inputs.i[1][0], inputs.i[1][1], inputs.i[1][2]};
    val x_i32x3: i32x3 = i32x3{inputs.i[0][0], inputs.i[0][1], inputs.i[0][2]};
    val y_i32x4: i32x4 = i32x4{inputs.i[1][0], inputs.i[1][1], inputs.i[1][2], inputs.i[1][3]};
    val x_i32x4: i32x4 = i32x4{inputs.i[0][0], inputs.i[0][1], inputs.i[0][2], inputs.i[0][3]};
    val y_i64:   i64   = inputs.i[1][0]::i64;
    val x_i64:   i64   = inputs.i[0][0]::i64;
    val y_i64x2: i64x2 = i64x2{inputs.i[1][0]::i64, inputs.i[1][1]::i64};
    val x_i64x2: i64x2 = i64x2{inputs.i[0][0]::i64, inputs.i[0][1]::i64};
    val y_i64x3: i64x3 = i64x3{inputs.i[1][0]::i64, inputs.i[1][1]::i64, inputs.i[1][2]::i64};
    val x_i64x3: i64x3 = i64x3{inputs.i[0][0]::i64, inputs.i[0][1]::i64, inputs.i[0][2]::i64};
    val y_i64x4: i64x4 = i64x4{inputs.i[1][0]::i64, inputs.i[1][1]::i64, inputs.i[1][2]::i64, inputs.i[1][3]::i64};
    val x_i64x4: i64x4 = i64x4{inputs.i[0][0]::i64, inputs.i[0][1]::i64, inputs.i[0][2]::i64, inputs.i[0][3]::i64};
    val y_u64:   u64   = inputs.u[1][0]::u64;
    val x_u64:   u64   = inputs.u[0][0]::u64;
    val y_u64x2: u64x2 = u64x2{inputs.u[1][0]::u64, inputs.u[1][1]::u64};
    val x_u64x2: u64x2 = u64x2{inputs.u[0][0]::u64, inputs.u[0][1]::u64};
    val y_u64x3: u64x3 = u64x3{inputs.u[1][0]::u64, inputs.u[1][1]::u64, inputs.u[1][2]::u64};
    val x_u64x3: u64x3 = u64x3{inputs.u[0][0]::u64, inputs.u[0][1]::u64, inputs.u[0][2]::u64};
    val y_u64x4: u64x4 = u64x4{inputs.u[1][0]::u64, inputs.u[1][1]::u64, inputs.u[1][2]::u64, inputs.u[1][3]::u64};
    val x_u64x4: u64x4 = u64x4{inputs.u[0][0]::u64, inputs.u[0][1]::u64, inputs.u[0][2]::u64, inputs.u[0][3]::u64};
    val y_f16:   f16   = inputs.f[1][0]::f16;
    val x_f16:   f16   = inputs.f[0][0]::f16;
    val y_f16x2: f16x2 = f16x2{inputs.f[1][0]::f16, inputs.f[1][1]::f16};
    val x_f16x2: f16x2 = f16x2{inputs.f[0][0]::f16, inputs.f[0][1]::f16};
    val y_f16x3: f16x3 = f16x3{inputs.f[1][0]::f16, inputs.f[1][1]::f16, inputs.f[1][2]::f16};
    val x_f16x3: f16x3 = f16x3{inputs.f[0][0]::f16, inputs.f[0][1]::f16, inputs.f[0][2]::f16};
    val y_f16x4: f16x4 = f16x4{inputs.f[1][0]::f16, inputs.f[1][1]::f16, inputs.f[1][2]::f16, inputs.f[1][3]::f16};
    val x_f16x4: f16x4 = f16x4{inputs.f[0][0]::f16, inputs.f[0][1]::f16, inputs.f[0][2]::f16, inputs.f[0][3]::f16};
    val y_f32:   f32   = inputs.f[1][0];
    val x_f32:   f32   = inputs.f[0][0];
    val y_f32x2: f32x2 = f32x2{inputs.f[1][0], inputs.f[1][1]};
    val x_f32x2: f32x2 = f32x2{inputs.f[0][0], inputs.f[0][1]};
    val y_f32x3: f32x3 = f32x3{inputs.f[1][0], inputs.f[1][1], inputs.f[1][2]};
    val x_f32x3: f32x3 = f32x3{inputs.f[0][0], inputs.f[0][1], inputs.f[0][2]};
    val y_f32x4: f32x4 = f32x4{inputs.f[1][0], inputs.f[1][1], inputs.f[1][2], inputs.f[1][3]};
    val x_f32x4: f32x4 = f32x4{inputs.f[0][0], inputs.f[0][1], inputs.f[0][2], inputs.f[0][3]};
    val y_f64:   f64   = inputs.f[1][0]::f64;
    val x_f64:   f64   = inputs.f[0][0]::f64;
    val y_f64x2: f64x2 = f64x2{inputs.f[1][0]::f64, inputs.f[1][1]::f64};
    val x_f64x2: f64x2 = f64x2{inputs.f[0][0]::f64, inputs.f[0][1]::f64};
    val y_f64x3: f64x3 = f64x3{inputs.f[1][0]::f64, inputs.f[1][1]::f64, inputs.f[1][2]::f64};
    val x_f64x3: f64x3 = f64x3{inputs.f[0][0]::f64, inputs.f[0][1]::f64, inputs.f[0][2]::f64};
    val y_f64x4: f64x4 = f64x4{inputs.f[1][0]::f64, inputs.f[1][1]::f64, inputs.f[1][2]::f64, inputs.f[1][3]::f64};
    val x_f64x4: f64x4 = f64x4{inputs.f[0][0]::f64, inputs.f[0][1]::f64, inputs.f[0][2]::f64, inputs.f[0][3]::f64};
    var total_u: u32   = 0;
    var total_f: f32   = 0.0;
    val r0:      u32   = m.logical_and(x_u32, y_u32);
    total_u = total_u + r0;
    val r1: u32 = m.logical_or(x_u32, y_u32);
    total_u = total_u + r1;
    val r2: u32 = m.logical_not(x_u32);
    total_u = total_u + r2;
    val r3: u32 = m.logical_equal(x_u32, y_u32);
    total_u = total_u + r3;
    val r4: u32 = m.logical_not_equal(x_u32, y_u32);
    total_u = total_u + r4;
    val r5: u32x2 = m.logical_and_2(x_u32x2, y_u32x2);
    total_u = total_u + r5[0];
    val r6: u32x2 = m.logical_or_2(x_u32x2, y_u32x2);
    total_u = total_u + r6[0];
    val r7: u32x2 = m.logical_not_2(x_u32x2);
    total_u = total_u + r7[0];
    val r8: u32x2 = m.logical_equal_2(x_u32x2, y_u32x2);
    total_u = total_u + r8[0];
    val r9: u32x2 = m.logical_not_equal_2(x_u32x2, y_u32x2);
    total_u = total_u + r9[0];
    val r10: u32x3 = m.logical_and_3(x_u32x3, y_u32x3);
    total_u = total_u + r10[0];
    val r11: u32x3 = m.logical_or_3(x_u32x3, y_u32x3);
    total_u = total_u + r11[0];
    val r12: u32x3 = m.logical_not_3(x_u32x3);
    total_u = total_u + r12[0];
    val r13: u32x3 = m.logical_equal_3(x_u32x3, y_u32x3);
    total_u = total_u + r13[0];
    val r14: u32x3 = m.logical_not_equal_3(x_u32x3, y_u32x3);
    total_u = total_u + r14[0];
    val r15: u32x4 = m.logical_and_4(x_u32x4, y_u32x4);
    total_u = total_u + r15[0];
    val r16: u32x4 = m.logical_or_4(x_u32x4, y_u32x4);
    total_u = total_u + r16[0];
    val r17: u32x4 = m.logical_not_4(x_u32x4);
    total_u = total_u + r17[0];
    val r18: u32x4 = m.logical_equal_4(x_u32x4, y_u32x4);
    total_u = total_u + r18[0];
    val r19: u32x4 = m.logical_not_equal_4(x_u32x4, y_u32x4);
    total_u = total_u + r19[0];
    val r20: u32 = m.all_2(x_u32x2);
    total_u = total_u + r20;
    val r21: u32 = m.any_2(x_u32x2);
    total_u = total_u + r21;
    val r22: u32 = m.all_3(x_u32x3);
    total_u = total_u + r22;
    val r23: u32 = m.any_3(x_u32x3);
    total_u = total_u + r23;
    val r24: u32 = m.all_4(x_u32x4);
    total_u = total_u + r24;
    val r25: u32 = m.any_4(x_u32x4);
    total_u = total_u + r25;
    val r26: i16 = m.select_i16(x_u32, y_i16, x_i16);
    total_u = total_u + r26::u32;
    val r27: i16x2 = m.select_i16_2(x_u32x2, y_i16x2, x_i16x2);
    total_u = total_u + r27[0]::u32;
    val r28: i16x3 = m.select_i16_3(x_u32x3, y_i16x3, x_i16x3);
    total_u = total_u + r28[0]::u32;
    val r29: i16x4 = m.select_i16_4(x_u32x4, y_i16x4, x_i16x4);
    total_u = total_u + r29[0]::u32;
    val r30: u16 = m.select_u16(x_u32, y_u16, x_u16);
    total_u = total_u + r30::u32;
    val r31: u16x2 = m.select_u16_2(x_u32x2, y_u16x2, x_u16x2);
    total_u = total_u + r31[0]::u32;
    val r32: u16x3 = m.select_u16_3(x_u32x3, y_u16x3, x_u16x3);
    total_u = total_u + r32[0]::u32;
    val r33: u16x4 = m.select_u16_4(x_u32x4, y_u16x4, x_u16x4);
    total_u = total_u + r33[0]::u32;
    val r34: i32 = m.select_i32(x_u32, y_i32, x_i32);
    total_u = total_u + r34::u32;
    val r35: i32x2 = m.select_i32_2(x_u32x2, y_i32x2, x_i32x2);
    total_u = total_u + r35[0]::u32;
    val r36: i32x3 = m.select_i32_3(x_u32x3, y_i32x3, x_i32x3);
    total_u = total_u + r36[0]::u32;
    val r37: i32x4 = m.select_i32_4(x_u32x4, y_i32x4, x_i32x4);
    total_u = total_u + r37[0]::u32;
    val r38: u32 = m.select_u32(x_u32, y_u32, x_u32);
    total_u = total_u + r38;
    val r39: u32x2 = m.select_u32_2(x_u32x2, y_u32x2, x_u32x2);
    total_u = total_u + r39[0];
    val r40: u32x3 = m.select_u32_3(x_u32x3, y_u32x3, x_u32x3);
    total_u = total_u + r40[0];
    val r41: u32x4 = m.select_u32_4(x_u32x4, y_u32x4, x_u32x4);
    total_u = total_u + r41[0];
    val r42: i64 = m.select_i64(x_u32, y_i64, x_i64);
    total_u = total_u + r42::u32;
    val r43: i64x2 = m.select_i64_2(x_u32x2, y_i64x2, x_i64x2);
    total_u = total_u + r43[0]::u32;
    val r44: i64x3 = m.select_i64_3(x_u32x3, y_i64x3, x_i64x3);
    total_u = total_u + r44[0]::u32;
    val r45: i64x4 = m.select_i64_4(x_u32x4, y_i64x4, x_i64x4);
    total_u = total_u + r45[0]::u32;
    val r46: u64 = m.select_u64(x_u32, y_u64, x_u64);
    total_u = total_u + r46::u32;
    val r47: u64x2 = m.select_u64_2(x_u32x2, y_u64x2, x_u64x2);
    total_u = total_u + r47[0]::u32;
    val r48: u64x3 = m.select_u64_3(x_u32x3, y_u64x3, x_u64x3);
    total_u = total_u + r48[0]::u32;
    val r49: u64x4 = m.select_u64_4(x_u32x4, y_u64x4, x_u64x4);
    total_u = total_u + r49[0]::u32;
    val r50: f16 = m.select_f16(x_u32, y_f16, x_f16);
    total_f = total_f + r50::f32;
    val r51: f16x2 = m.select_f16_2(x_u32x2, y_f16x2, x_f16x2);
    total_f = total_f + r51[0]::f32;
    val r52: f16x3 = m.select_f16_3(x_u32x3, y_f16x3, x_f16x3);
    total_f = total_f + r52[0]::f32;
    val r53: f16x4 = m.select_f16_4(x_u32x4, y_f16x4, x_f16x4);
    total_f = total_f + r53[0]::f32;
    val r54: f32 = m.select_f32(x_u32, y_f32, x_f32);
    total_f = total_f + r54;
    val r55: f32x2 = m.select_f32_2(x_u32x2, y_f32x2, x_f32x2);
    total_f = total_f + r55[0];
    val r56: f32x3 = m.select_f32_3(x_u32x3, y_f32x3, x_f32x3);
    total_f = total_f + r56[0];
    val r57: f32x4 = m.select_f32_4(x_u32x4, y_f32x4, x_f32x4);
    total_f = total_f + r57[0];
    val r58: f64 = m.select_f64(x_u32, y_f64, x_f64);
    total_f = total_f + r58::f32;
    val r59: f64x2 = m.select_f64_2(x_u32x2, y_f64x2, x_f64x2);
    total_f = total_f + r59[0]::f32;
    val r60: f64x3 = m.select_f64_3(x_u32x3, y_f64x3, x_f64x3);
    total_f = total_f + r60[0]::f32;
    val r61: f64x4 = m.select_f64_4(x_u32x4, y_f64x4, x_f64x4);
    total_f   = total_f + r61[0]::f32;
    outputs.u = total_u;
    outputs.f = total_f;
}
