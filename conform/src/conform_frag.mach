# Calls one entry from every family at every width.
#
# This exists to be compiled, not to shade anything. Each call forces the
# compiler to resolve a `#[spirv_op]` decorator and emit the instruction at that
# operand width, so a wrong instruction name or a signature SPIR-V rejects turns
# into a build failure here. The library on its own compiles to nothing and would
# catch neither.
#
# The result is written to the output so no call can be eliminated as dead.

use sh: shader.math;

#[input(0)]
var a2: f32x2;
#[input(1)]
var b2: f32x2;
#[input(2)]
var a3: f32x3;
#[input(3)]
var b3: f32x3;
#[input(4)]
var a4: f32x4;
#[input(5)]
var b4: f32x4;
#[input(6)]
var s:  f32;

#[output(0)]
var out_colour: f32x4;

#[stage("fragment")]
fun frag_main() {
    # Scalar: one entry from each of the four groups.
    val u: f32 = sh.sqrt(sh.abs(s)) + sh.atan2(s, s)
        + sh.smooth_step(0.0, 1.0, s) + sh.fma(s, s, s)
        + sh.degrees(sh.sin(s)) + sh.log2(sh.exp2(s));

    # Two lanes.
    val v2: f32x2 = sh.fma_2(sh.abs_2(a2), sh.max_2(a2, b2),
        sh.mix_2(a2, b2, sh.fract_2(a2)));
    val g2: f32 = sh.dot_2(sh.normalize_2(v2), sh.reflect_2(a2, sh.normalize_2(b2)))
        + sh.length_2(v2) + sh.distance_2(a2, b2);

    # Three lanes, including the cross product that exists at no other width.
    val n3: f32x3 = sh.normalize_3(sh.cross_3(a3, b3));
    val v3: f32x3 = sh.refract_3(sh.normalize_3(a3), n3, 1.5);
    val f3: f32x3 = sh.face_forward_3(n3, a3, b3);
    val g3: f32   = sh.dot_3(v3, f3) + sh.length_3(sh.clamp_3(a3, b3, a3))
        + sh.distance_3(sh.sin_3(a3), sh.pow_3(sh.abs_3(b3), a3));

    # Four lanes.
    val v4: f32x4 = sh.mix_4(sh.floor_4(a4), sh.ceil_4(b4),
        sh.step_4(a4, sh.inverse_sqrt_4(sh.abs_4(b4))));
    val g4: f32 = sh.dot_4(sh.normalize_4(v4), sh.face_forward_4(v4, a4, b4))
        + sh.length_4(sh.min_4(a4, b4)) + sh.distance_4(a4, b4);

    # The split entries at every width, each storing its second part through a local.
    var whole:  f32;
    var e:      i32;
    var whole2: f32x2;
    var e2:     i32x2;
    var whole3: f32x3;
    var e3:     i32x3;
    var whole4: f32x4;
    var e4:     i32x4;
    val m:      f32   = sh.modf(s, ?whole) + sh.frexp(s, ?e) + whole + e::f32;
    val m2:     f32x2 = sh.modf_2(a2, ?whole2) + sh.frexp_2(b2, ?e2) + whole2;
    val m3:     f32x3 = sh.modf_3(a3, ?whole3) + sh.frexp_3(b3, ?e3) + whole3;
    val m4:     f32x4 = sh.modf_4(a4, ?whole4) + sh.frexp_4(b4, ?e4) + whole4;
    val split:  f32   = m + m2[1] + m3[2] + m4[3] + (e2[1] + e3[2] + e4[3])::f32;

    # The integer rows, signed and unsigned, scalar and vector.
    val k:  i32 = s::i32;
    val q:  u32 = s::u32;
    val ki: i32 = sh.abs_i32(k) + sh.sign_i32(k) + sh.min_i32(k, 3) + sh.max_i32(k, -3)
        + sh.clamp_i32(k, -1, 1) + sh.find_lsb_i32(k) + sh.find_msb_i32(k);
    val qu: u32 = sh.min_u32(q, 3) + sh.max_u32(q, 1) + sh.clamp_u32(q, 1, 4)
        + sh.find_lsb_u32(q) + sh.find_msb_u32(q);
    val k2:   i32x2 = sh.clamp_i32_2(sh.abs_i32_2(i32x2{k, ki}), i32x2{0, 0}, i32x2{9, 9});
    val k3:   i32x3 = sh.find_msb_i32_3(sh.min_i32_3(sh.sign_i32_3(i32x3{k, ki, k}), i32x3{k, k, k}));
    val k4:   i32x4 = sh.max_i32_4(sh.find_lsb_i32_4(i32x4{k, ki, k, ki}), i32x4{k, k, k, k});
    val q2:   u32x2 = sh.find_msb_u32_2(sh.max_u32_2(u32x2{q, qu}, u32x2{1, 1}));
    val q3:   u32x3 = sh.clamp_u32_3(sh.find_lsb_u32_3(u32x3{q, qu, q}), u32x3{0, 0, 0}, u32x3{q, q, q});
    val q4:   u32x4 = sh.min_u32_4(u32x4{q, qu, q, qu}, u32x4{qu, q, qu, q});
    val ints: f32   = (ki + k2[1] + k3[2] + k4[3])::f32 + (qu + q2[1] + q3[2] + q4[3])::f32;

    val total: f32 = u + g2 + g3 + g4 + split + ints;
    out_colour = f32x4{total, total, total, total};
}
